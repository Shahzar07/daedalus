# =============================================================================
# Daedalus configuration. Copy this file to `.env` and edit.
#   cp .env.example .env        (macOS/Linux)
#   Copy-Item .env.example .env (Windows PowerShell)
#
# Everything here has a safe default. The agent runs with NO API KEYS at all if
# you use the local Ollama provider (or the built-in `mock` provider for tests).
# =============================================================================

# ----- Model provider ---------------------------------------------------------
# Which backend to talk to. One of:
#   ollama      local models, $0, no key            (default)
#   groq        fast hosted free tier               (needs GROQ_API_KEY)
#   gemini      Google free tier, vision-capable    (needs GEMINI_API_KEY)
#   openrouter  many free + paid models             (needs OPENROUTER_API_KEY)
#   openai      OpenAI paid                          (needs OPENAI_API_KEY)
#   custom      ANY OpenAI-compatible endpoint       (set OPENAI_BASE_URL + key)
#   mock        deterministic, offline, for tests    (no network)
MODEL_PROVIDER=ollama

# Model name as the provider expects it. Examples:
#   ollama:     qwen2.5, llama3.2, mistral
#   groq:       llama-3.3-70b-versatile
#   gemini:     gemini-2.0-flash
#   openrouter: meta-llama/llama-3.3-70b-instruct:free
MODEL_NAME=qwen2.5

# ----- Provider keys (only fill in the one you use) ---------------------------
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# ----- Custom / advanced endpoint ---------------------------------------------
# For MODEL_PROVIDER=custom, point at any OpenAI-compatible server
# (LM Studio, vLLM, Together, a proxy, etc.). For other providers this is
# auto-filled, but you may override it (e.g. a non-default Ollama host).
#   Ollama default: http://localhost:11434/v1
OPENAI_BASE_URL=

# Fastest way to connect a custom endpoint: instead of filling the fields above,
# paste the provider's own `curl` example and Daedalus extracts the base URL,
# Bearer key, and model from it. Even easier, run:
#   dae connect 'curl https://api.example.com/v1/chat/completions -H "Authorization: Bearer KEY" -d "{\"model\":\"NAME\"}"'
# which parses the curl, live-tests it, and writes the clean fields below for you.
CUSTOM_CURL=

# ----- Agent limits & safety --------------------------------------------------
MAX_STEPS=12              # max tool-use iterations per request (loop guard)
DAILY_BUDGET_USD=1.00     # hard daily cost cap; agent halts on breach (M6)
SANDBOX=subprocess        # docker | subprocess  (Docker isolation added in M6)
REQUEST_TIMEOUT=180       # seconds to wait for a model response (raise for slow/cold models)

# ----- M10 upgrades -----------------------------------------------------------
# Reflection: a second model pass reviews (and may rewrite) each answer. Off by default
# (it doubles model calls per turn); turn on for higher accuracy on hard tasks.
REFLECTION=false
REFLECTION_MAX_REVISIONS=1
# Subagents: let the agent delegate self-contained subtasks to bounded child agents.
# $0 and on by default; hard-capped so it can't fan out without limit.
SUBAGENTS=true
SUBAGENT_MAX_DEPTH=1      # 1 = top agent may spawn, its children may not
SUBAGENT_MAX_CHILDREN=3   # per request
# Memory graph: lightweight entity/relation recall over remembered facts ($0, no deps).
MEMORY_GRAPH=true
# Semantic memory: recall by meaning. Needs the [semantic] extra + a one-time model
# download, so it's opt-in.  uv pip install -e ".[semantic]"
SEMANTIC_MEMORY=false

# ----- Voice (M10; needs the [voice] extra) -----------------------------------
# `dae voice` records from the mic, transcribes (faster-whisper), answers, and speaks
# back (Piper). WHISPER_MODEL picks the STT size; PIPER_VOICE points at a downloaded
# Piper voice (.onnx) — without it, speech output is skipped but STT still works.
WHISPER_MODEL=base
PIPER_VOICE=

# ----- Tools ------------------------------------------------------------------
# Optional self-hosted SearXNG for web search. If empty, Daedalus uses a free,
# keyless DuckDuckGo fallback.
SEARXNG_URL=

# ----- Messaging surfaces (M8) ------------------------------------------------
# Telegram: create a bot with @BotFather, paste its token here, run `dae telegram`.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat IDs allowed to talk to the bot (message @userinfobot to find
# yours). EMPTY = "open mode": the bot answers ANYONE — fine for a quick test, but set
# this before leaving a public bot running. e.g. TELEGRAM_ALLOWED_CHAT_IDS=123456789
TELEGRAM_ALLOWED_CHAT_IDS=
# WhatsApp uses a small local Node bridge (unofficial; see bridge/whatsapp/README.md).
# This is the localhost address that bridge's HTTP API listens on — change only if the
# default port clashes with something else.
WHATSAPP_BRIDGE_URL=http://127.0.0.1:8765

# ----- MCP — Model Context Protocol servers (M9) ------------------------------
# Expose tools from any MCP server to the agent with zero code changes. MCP_SERVERS is
# a JSON array; each entry is one server. Two transports are supported:
#
#   stdio (spawns a local process) — give "command" (+ optional "args"/"env"):
#     {"name":"fs","command":"npx",
#      "args":["-y","@modelcontextprotocol/server-filesystem","/path/to/dir"]}
#
#   sse (connects to a running server over HTTP) — give "url":
#     {"name":"remote","url":"http://localhost:9000/sse"}
#
# Optional per-server "requires_approval":true routes that server's tools through the
# same Allow/Deny gate as the shell/file tools. Tools are namespaced <name>__<tool>.
# Needs the extra:  uv pip install -e ".[mcp]"
# Example (filesystem server over your workspace):
#   MCP_SERVERS=[{"name":"fs","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","."]}]
MCP_SERVERS=[]
